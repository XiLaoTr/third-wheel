{
  "name": "third-wheel",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @third-wheel/desktop dev",
    "dev:open": "node scripts/dev-open.js",
    "build": "pnpm --filter @third-wheel/desktop build && pnpm build:mcp",
    "build:mcp": "pnpm --filter @third-wheel/mcp-server build",
    "dist": "pnpm build && pnpm --filter @third-wheel/desktop dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @third-wheel/desktop exec playwright test",
    "test:watch": "vitest",
    "notices": "node scripts/third-party-notices.js",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
